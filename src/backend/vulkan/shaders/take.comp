#version 450
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

void main() {
    if (gl_LocalInvocationID.x != 0u) return;
    uint slot = scratch[p.reduce_dst];
    if (slot == INVALID) {
        output_words[2u * p.output_index] = INVALID;
        output_words[2u * p.output_index + 1u] = 0x7f800000u;
        return;
    }
    output_words[2u * p.output_index] = scratch[2u * slot];
    output_words[2u * p.output_index + 1u] = scratch[2u * slot + 1u];
    scratch[2u * slot] = INVALID;
}
