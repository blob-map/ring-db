#version 450
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

void main() {
    if (gl_LocalInvocationID.x != 0u) return;
    uint slot = scratch_word(p.reduce_dst).value;
    if (slot == INVALID) {
        output_word(2ul * p.output_index).value = INVALID;
        output_word(2ul * p.output_index + 1u).value = 0x7f800000u;
        return;
    }
    output_word(2ul * p.output_index).value = scratch_word(2ul * slot).value;
    output_word(2ul * p.output_index + 1u).value = scratch_word(2ul * slot + 1u).value;
    scratch_word(2ul * slot).value = INVALID;
}
