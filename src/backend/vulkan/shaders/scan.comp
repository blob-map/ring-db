#version 450
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

// Specialize away candidate checks entirely for unfiltered queries.
layout(constant_id = 0) const uint CANDIDATE_MODE = 0;

float weighted_step(uint id, uint coord, uint query_offset, float sum) {
    float weight = uintBitsToFloat(inputs[query_offset + p.dims + coord]);
    if (weight == 0.0) return sum;
    float delta = vectors[coord * p.rows + id]
        - uintBitsToFloat(inputs[query_offset + coord]);
    return fma(weight, delta * delta, sum);
}

float ordinary_step(uint id, uint coord, uint query_offset, float sum) {
    float delta = vectors[coord * p.rows + id]
        - uintBitsToFloat(inputs[query_offset + coord]);
    return fma(delta, delta, sum);
}

float distance_sq(uint id, uint disk) {
    uint offset = disk * (2u + 2u * p.dims);
    uint query_offset = offset + 2u;
    precise vec4 sums = vec4(0.0);
    uint aligned_dims = p.dims & ~3u;
    uint i = 0u;
    if (inputs[offset] != 0u) {
        for (; i < aligned_dims; i += 4u) {
            sums.x = weighted_step(id, i, query_offset, sums.x);
            sums.y = weighted_step(id, i + 1u, query_offset, sums.y);
            sums.z = weighted_step(id, i + 2u, query_offset, sums.z);
            sums.w = weighted_step(id, i + 3u, query_offset, sums.w);
        }
        precise float sum = (sums.x + sums.y) + (sums.z + sums.w);
        for (; i < p.dims; ++i) sum = weighted_step(id, i, query_offset, sum);
        return sum;
    }
    for (; i < aligned_dims; i += 4u) {
        sums.x = ordinary_step(id, i, query_offset, sums.x);
        sums.y = ordinary_step(id, i + 1u, query_offset, sums.y);
        sums.z = ordinary_step(id, i + 2u, query_offset, sums.z);
        sums.w = ordinary_step(id, i + 3u, query_offset, sums.w);
    }
    precise float sum = (sums.x + sums.y) + (sums.z + sums.w);
    for (; i < p.dims; ++i) sum = ordinary_step(id, i, query_offset, sum);
    return sum;
}

void main() {
    uint slot = group_index() * 128u + gl_LocalInvocationID.x;
    if (slot >= p.work_count) return;
    if (p.mode == 2u) {
        scratch[2u * slot] = INVALID;
        scratch[2u * slot + 1u] = 0x7f800000u;
    }
    uint id = slot;
    if (CANDIDATE_MODE == 1u) id = inputs[p.candidate_offset + slot];
    if (CANDIDATE_MODE == 2u) {
        uint bits = inputs[p.candidate_offset + id / 32u];
        if ((bits & (1u << (id % 32u))) == 0u) return;
    }
    float first = distance_sq(id, 0u);
    if (p.mode == 2u) {
        scratch[2u * slot] = id;
        scratch[2u * slot + 1u] = floatBitsToUint(first);
        return;
    }
    if (p.mode == 0u) {
        if (!(first >= p.lower_sq && first <= p.upper_sq)) return;
    } else {
        if (first > uintBitsToFloat(inputs[1])) return;
        for (uint disk = 1u; disk < p.disk_count; ++disk) {
            float upper_sq = uintBitsToFloat(inputs[disk * (2u + 2u * p.dims) + 1u]);
            if (distance_sq(id, disk) > upper_sq) return;
        }
    }
    uint dst = atomicAdd(output_words[0], 1u);
    output_words[1u + 2u * dst] = id;
    output_words[2u + 2u * dst] = floatBitsToUint(first);
}
