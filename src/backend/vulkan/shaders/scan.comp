#version 450
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

// Specialize away candidate checks entirely for unfiltered queries.
layout(constant_id = 0) const uint CANDIDATE_MODE = 0;

float weighted_step(uint id, uint coord, uint query_offset, float sum) {
    float weight = uintBitsToFloat(input_word(query_offset + p.dims + coord));
    if (weight == 0.0) return sum;
    float delta = vector_value(id, coord)
        - uintBitsToFloat(input_word(query_offset + coord));
    return fma(weight, delta * delta, sum);
}

float ordinary_step(uint id, uint coord, uint query_offset, float sum) {
    float delta = vector_value(id, coord)
        - uintBitsToFloat(input_word(query_offset + coord));
    return fma(delta, delta, sum);
}

float distance_sq(uint id, uint disk) {
    uint offset = disk * (2u + 2u * p.dims);
    uint query_offset = offset + 2u;
    precise vec4 sums = vec4(0.0);
    uint aligned_dims = p.dims & ~3u;
    uint i = 0u;
    if (input_word(offset) != 0u) {
        for (; i < aligned_dims; i += 4u) {
            sums.x = weighted_step(id, i, query_offset, sums.x);
            sums.y = weighted_step(id, i + 1u, query_offset, sums.y);
            sums.z = weighted_step(id, i + 2u, query_offset, sums.z);
            sums.w = weighted_step(id, i + 3u, query_offset, sums.w);
        }
        precise float sum = (sums.x + sums.y) + (sums.z + sums.w);
        for (; i < p.dims; ++i) sum = weighted_step(id, i, query_offset, sum);
        return sum;
    }
    for (; i < aligned_dims; i += 4u) {
        sums.x = ordinary_step(id, i, query_offset, sums.x);
        sums.y = ordinary_step(id, i + 1u, query_offset, sums.y);
        sums.z = ordinary_step(id, i + 2u, query_offset, sums.z);
        sums.w = ordinary_step(id, i + 3u, query_offset, sums.w);
    }
    precise float sum = (sums.x + sums.y) + (sums.z + sums.w);
    for (; i < p.dims; ++i) sum = ordinary_step(id, i, query_offset, sum);
    return sum;
}

void main() {
    uint group = group_index();
    if (group >= group_count(p.work_count - p.slot_base)) return;
    uint slot = p.slot_base + group * 128u + gl_LocalInvocationID.x;
    if (slot >= p.work_count) return;
    if (p.mode == 1u) {
        scratch_word(2ul * slot).value = INVALID;
        scratch_word(2ul * slot + 1u).value = 0x7f800000u;
    }
    uint id = slot;
    if (CANDIDATE_MODE == 1u) id = input_word(p.candidate_offset + slot) - p.row_offset;
    if (CANDIDATE_MODE == 2u) {
        uint bit_id = id + p.row_offset % 32u;
        uint bits = input_word(p.candidate_offset + bit_id / 32u);
        if ((bits & (1u << (bit_id % 32u))) == 0u) return;
    }
    if (p.mode == 1u) {
        scratch_word(2ul * slot).value = id + p.row_offset;
        scratch_word(2ul * slot + 1u).value = floatBitsToUint(distance_sq(id, 0u));
        return;
    }
    // Reject at the first disk that excludes the row; NaN never matches.
    float dists[MAX_DISKS];
    for (uint disk = 0u; disk < p.disk_count; ++disk) {
        float d = distance_sq(id, disk);
        float radius_sq = uintBitsToFloat(input_word(disk * (2u + 2u * p.dims) + 1u));
        if (!(d <= radius_sq)) return;
        dists[disk] = d;
    }
    // Output: the hit count, then per hit its row and disk_count distances.
    uint dst = atomicAdd(output_word(0).value, 1u);
    if (p.mode == 2u) return;
    uint64_t record = 1ul + uint64_t(dst) * uint64_t(1u + p.disk_count);
    output_word(record).value = id + p.row_offset + p.row_base;
    for (uint disk = 0u; disk < p.disk_count; ++disk) {
        output_word(record + 1ul + uint64_t(disk)).value = floatBitsToUint(dists[disk]);
    }
}
